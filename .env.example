# Copy to .env. Every value here is optional; the defaults run fully local.
# Then run scripts/lake-env.sh: it adds the lakehouse secrets (GARAGE_RPC_SECRET, LAKE_S3_KEY,
# LAKE_S3_SECRET, LAKE_DB_PASSWORD, INGEST_TOKEN), which have no defaults.
POSTGRES_PASSWORD=schemalab
OLLAMA_API_BASE=http://host.docker.internal:11434
# Free cloud fallbacks (no paid keys needed):
# GROQ_API_KEY=
# GEMINI_API_KEY=
# Host ports, if the defaults are taken
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
