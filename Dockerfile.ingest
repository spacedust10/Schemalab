# The lakehouse loader. Its own image because dlt pins duckdb<2 while the API runs 2.0.
FROM python:3.15-slim
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /app

COPY ingest/pyproject.toml ingest/uv.lock ./
RUN uv sync --frozen --no-dev

COPY ingest/src ./src
RUN useradd --create-home --uid 1000 app \
    && mkdir -p /data/lake/inbox /data/lake/publish && chown -R app /data/lake
USER app
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/app/src
# The extensions the lake needs, installed now so nothing downloads at run time.
RUN python -c "import duckdb; c = duckdb.connect(); [c.execute(f'INSTALL {e}') for e in ('ducklake', 'postgres', 'httpfs')]"
EXPOSE 8100
CMD ["uvicorn", "ingest.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8100"]
